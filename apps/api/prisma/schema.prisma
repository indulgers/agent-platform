generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // native = whatever the build host is (e.g. macOS arm64 during dev).
  // debian-openssl-3.0.x = node:20-slim runtime in production.
  // Without this, prisma only ships the engine matching the build host
  // and the api crashes on boot with 'Query Engine for runtime not found'.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  runs          Run[]
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New chat")
  /// nullable — if unset, the agent uses LLM_DEFAULT_PROVIDER + LLM_DEFAULT_MODEL.
  /// Resolved against the static registry in agents/models.registry.ts.
  model     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  runs      Run[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  toolCalls      Json?
  toolCallId     String?
  /// Filled in for assistant messages only. Shape:
  ///   { model, promptTokens, completionTokens, costUsd }
  usage          Json?
  /// Image attachments on a user message. Shape:
  ///   [{ key, kind: 'image', mediaType, size, originalName }]
  attachments    Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Vector-typed via raw SQL migration; Prisma sees it as Unsupported.
model MemoryChunk {
  id             String                      @id @default(cuid())
  userId         String
  conversationId String?
  content        String
  embedding      Unsupported("vector(1536)")
  createdAt      DateTime                    @default(now())

  @@index([userId])
}

/// Lifecycle of a durable Run — see docs/agents domain glossary.
enum RunStatus {
  planning
  awaiting_approval
  running
  paused
  done
  failed
}

/// A durable, resumable execution of an agent toward a Goal. References a
/// Conversation for its transcript so existing Message storage is reused.
model Run {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// The objective the user gave the agent.
  goal           String
  status         RunStatus    @default(planning)
  /// Set by the interrupt endpoint; the engine stops at its next checkpoint.
  interruptRequested Boolean  @default(false)
  /// Final result payload once the Run is done.
  result         Json?
  error          String?
  /// Accumulated token usage/cost. Shape: { promptTokens, completionTokens, costUsd }
  usage          Json?
  plan           Plan?
  steps          RunStep[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, updatedAt])
  @@index([conversationId])
}

/// The agent's proposed ordered steps for a Run; approved/edited by the user
/// before autonomous execution. One per Run.
model Plan {
  id         String    @id @default(cuid())
  runId      String    @unique
  run        Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Ordered array of plan steps: [{ index, description }]
  steps      Json
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// One persisted unit of a Run's execution (a reasoning/act/tool cycle), so a
/// Run can resume by replaying its step log.
model RunStep {
  id        String   @id @default(cuid())
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  /// e.g. 'plan' | 'act' | 'reflect' | 'tool_result' | 'checkpoint'
  kind      String
  data      Json
  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@index([runId])
}
